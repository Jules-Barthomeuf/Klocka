{
  "manifest_version": 3,
  "name": "Klocka, bloqueur du temps de travail",
  "version": "1.0.0",
  "description": "Ferme les sites choisis dans la page Productivité de Klocka pendant les temps de travail, et les rouvre aux pauses.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fond.js",
    "scripts": [
      "fond.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://klocka.immo/*",
        "https://*.klocka.immo/*"
      ],
      "js": [
        "relais.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bloque.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bloqueur@klocka.immo",
      "strict_min_version": "128.0"
    }
  }
}
