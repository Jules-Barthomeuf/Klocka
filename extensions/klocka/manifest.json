{
  "manifest_version": 3,
  "name": "Klocka",
  "version": "1.2.0",
  "description": "Écrire la réponse au message ouvert dans Gmail ou WhatsApp Web, et ranger une conversation sur les fiches de Klocka. Rien ne part sans vous.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://klocka.immo/*",
    "https://*.klocka.immo/*"
  ],
  "background": {
    "service_worker": "fond.js",
    "scripts": [
      "fond.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "fenetre.html",
    "default_title": "Assistant Klocka (Option + K)",
    "default_icon": {
      "16": "images/icone-16.png",
      "32": "images/icone-32.png",
      "48": "images/icone-48.png"
    },
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "ecrire.js",
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "ecrire.js",
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "assistant@klocka.immo",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "images/icone-16.png",
    "32": "images/icone-32.png",
    "48": "images/icone-48.png",
    "128": "images/icone-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Ouvrir l'assistant Klocka"
    }
  }
}
