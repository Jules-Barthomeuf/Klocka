{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "video_accueil_url": {
      "type": "string",
      "description": "URL de la vid\u00e9o Google Drive pour la page d'accueil des non-clients"
    },
    "setting_key": {
      "type": "string",
      "description": "Cl\u00e9 unique pour identifier ce param\u00e8tre (par exemple: 'global')"
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}