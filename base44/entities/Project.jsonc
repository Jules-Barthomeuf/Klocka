{
  "name": "Project",
  "type": "object",
  "properties": {
    "titre": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Projet archiv\u00e9"
    },
    "client_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des emails des clients assign\u00e9s au projet"
    },
    "client_email": {
      "type": "string"
    },
    "admin_principal": {
      "type": "string",
