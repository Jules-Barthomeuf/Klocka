{
  "name": "DocumentAnalyse",
  "type": "object",
  "properties": {
    "nom_fichier": {
      "type": "string",
      "description": "Nom du fichier upload\u00e9"
    },
    "url_fichier": {
      "type": "string",
      "description": "URL du fichier stock\u00e9"
    },
    "projet_id": {
      "type": "string",
      "description": "ID du projet associ\u00e9"
    },
    "categorie": {
      "type": "string",
      "enum": [
        "secteur",
        "locataire",
        "copropriete",
        "marche",
        "diagnostique",
        "images",
        "autre"
      ],
      "description": "Cat\u00e9gorie du document"
    },
    "type_document": {
      "type": "string",
      "enum": [
        "bail",
        "acte_propriete",
        "diagnostic",
        "pv_ag",
        "comptabilite",
        "autre"
      ],
      "description": "Type de document"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente",
        "en_cours",
        "verifie",
        "non_verifie"
      ],
      "default": "en_attente",
      "description": "Statut de v\u00e9rification"
    },
    "notes_ia": {
      "type": "string",
      "description": "Notes g\u00e9n\u00e9r\u00e9es par l'IA"
    },
    "notes_manuelles": {
      "type": "string",
      "description": "Notes ajout\u00e9es manuellement"
    },
    "points_attention": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titre": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "niveau": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          }
        }
      },
      "description": "Points d'attention relev\u00e9s par l'IA"
    }
  },
  "required": [
    "nom_fichier"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}