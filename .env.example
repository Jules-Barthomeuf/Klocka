# Copiez ce fichier vers .env et remplissez ce dont vous avez besoin.
# ATTENTION : .env.example est suivi par git — n'y mettez JAMAIS de vrai secret.
# Les secrets vont dans .env, qui est ignoré par git.

# --- IA (rédaction des mails, KlockAI, extraction de documents) ---
# Deux fournisseurs possibles. Sans aucune clé, l'app tourne avec des réponses
# de repli (le prompt mail bascule sur un matching par mots-clés).

# Gemini — clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude — alternative.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Si les deux clés sont renseignées, Gemini l'emporte. Forcez le choix avec
# LLM_PROVIDER=gemini ou LLM_PROVIDER=anthropic. Vide = détection automatique.
LLM_PROVIDER=

# Port unique de l'application (interface + API).
PORT=3001

# URL publique de l'app. Doit correspondre à ce que vous tapez dans le
# navigateur — c'est elle qui construit l'URL de retour de la connexion Google.
# En Codespaces : https://<nom-du-codespace>-3001.app.github.dev
#
# EN PRODUCTION : obligatoirement votre domaine en https. Le « https:// »
# déclenche le mode production : cookies Secure, CORS restreint à ce domaine,
# aucune donnée de démonstration au premier démarrage.
APP_URL=http://localhost:3001

# Compte admin créé au premier démarrage.
KLOCKA_ADMIN_EMAIL=vous@exemple.fr

# Clé de déchiffrement de l'instantané de données du dépôt
# (server/data-seed/donnees.enc). Avec cette clé, un déploiement neuf se
# remplit tout seul au démarrage : comptes, projets, clients… Rafraîchir
# l'instantané : node server/seed-donnees.js exporter
# KLOCKA_SEED_KEY=64_caracteres_hexadecimaux

# --- Connexion ---
# L'app s'authentifie par email + mot de passe. Seules les adresses déjà
# présentes en base peuvent entrer : à la première connexion, l'utilisateur
# choisit son mot de passe, ensuite il le saisit.
#
# Uniquement pour du développement local : ouvre l'app sans authentification en
# se connectant automatiquement au compte admin. JAMAIS sur un serveur exposé.
AUTH_DESACTIVEE=false

# --- Connexion Google (optionnelle, désactivée si vide) ---
# Une seule connexion sert à la fois à entrer dans l'application et à envoyer
# les mails. Identifiants du client OAuth créé sur
# https://console.cloud.google.com (APIs & Services > Credentials >
# OAuth client ID > Application Web).
# URI de redirection à déclarer : <APP_URL>/api/auth/google/callback
# Voir la section « Connexion » du README.
#
# L'authentification (email + mot de passe) reste exigée même sans ces valeurs :
# elles n'activent que le bouton « Se connecter avec Google » et l'envoi Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel : restreindre l'accès à un domaine (ex. klocka.immo). Le mode
# « Internal » de Google le fait déjà ; ceci ajoute une seconde barrière.
# Attention : tant que ce champ est rempli, aucune autre adresse ne peut entrer.
ALLOWED_EMAIL_DOMAIN=

# Demander en plus l'autorisation d'envoyer des mails (portée gmail.send).
# false = la connexion sert uniquement à s'authentifier (consentement plus
# simple, rien à déclarer dans Data Access).
GOOGLE_GMAIL_SEND=false

# Lire la boîte de réception (portée gmail.readonly) : alimente l'onglet
# « Boîte de réception » de la page Mails et le bouton « Préanalyser » sur un
# mail reçu. Portée « restricted » chez Google : à déclarer dans Data Access.
# Les comptes déjà connectés doivent se reconnecter pour accorder la lecture.
GOOGLE_GMAIL_READ=false

# Classer les documents d'un deal dans le Drive du compte connecté (portée
# drive.file : l'app ne voit que les dossiers/fichiers qu'elle a créés).
GOOGLE_DRIVE=false

# --- Cycle de vie des deals de préanalyse ---
# Nombre de jours avant de proposer une relance après une demande de documents.
DEAL_RELANCE_JOURS=7

# --- Carte Google Maps (front) ---
# Clé Google Maps Embed API pour les cartes des pages Préanalyse et Projet.
# Sans clé, un simple lien externe vers Google Maps est proposé.
VITE_GOOGLE_MAPS_API_KEY=

# --- Envoi par mot de passe d'application (optionnel, alternative à Google) ---
# Si vous préférez ne pas passer par OAuth. Un bloc par expéditeur, numéroté
# sans trou. Le mot de passe est un mot de passe d'application Google
# (https://myaccount.google.com/apppasswords), pas le mot de passe du compte.
# SMTP_1_NAME=Prénom Nom
# SMTP_1_USER=prenom@exemple.fr
# SMTP_1_PASS=xxxx xxxx xxxx xxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
