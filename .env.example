# Copiez ce fichier vers .env et remplissez ce dont vous avez besoin.
# ATTENTION : .env.example est suivi par git — n'y mettez JAMAIS de vrai secret.
# Les secrets vont dans .env, qui est ignoré par git.

# --- IA (rédaction des mails, KlockAI, extraction de documents) ---
# Deux fournisseurs possibles. Sans aucune clé, l'app tourne avec des réponses
# de repli (le prompt mail bascule sur un matching par mots-clés).

# Gemini — clé à créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude — alternative.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Si les deux clés sont renseignées, Claude l'emporte. Forcez le choix avec
# LLM_PROVIDER=gemini ou LLM_PROVIDER=anthropic. Vide = détection automatique.
LLM_PROVIDER=

# Port unique de l'application (interface + API).
PORT=3001

# URL publique de l'app. Doit correspondre à ce que vous tapez dans le
# navigateur — c'est elle qui construit l'URL de retour de la connexion Google.
# En Codespaces : https://<nom-du-codespace>-3001.app.github.dev
#
# EN PRODUCTION : obligatoirement votre domaine en https. Le « https:// »
# déclenche le mode production : cookies Secure, CORS restreint à ce domaine,
# aucune donnée de démonstration au premier démarrage.
APP_URL=http://localhost:3001

# Compte admin créé au premier démarrage.
KLOCKA_ADMIN_EMAIL=vous@exemple.fr

# Clé de déchiffrement de l'instantané de données du dépôt
# (server/data-seed/donnees.enc). Avec cette clé, un déploiement neuf se
# remplit tout seul au démarrage : comptes, projets, clients… Rafraîchir
# l'instantané : node server/seed-donnees.js exporter
# KLOCKA_SEED_KEY=64_caracteres_hexadecimaux

# --- Connexion ---
# L'app s'authentifie par email + mot de passe. Seules les adresses déjà
# présentes en base peuvent entrer : à la première connexion, l'utilisateur
# choisit son mot de passe, ensuite il le saisit.
#
# Uniquement pour du développement local : ouvre l'app sans authentification en
# se connectant automatiquement au compte admin. JAMAIS sur un serveur exposé.
AUTH_DESACTIVEE=false

# --- Connexion Google (optionnelle, désactivée si vide) ---
# Une seule connexion sert à la fois à entrer dans l'application et à envoyer
# les mails. Identifiants du client OAuth créé sur
# https://console.cloud.google.com (APIs & Services > Credentials >
# OAuth client ID > Application Web).
# URI de redirection à déclarer : <APP_URL>/api/auth/google/callback
# Voir la section « Connexion » du README.
#
# L'authentification (email + mot de passe) reste exigée même sans ces valeurs :
# elles n'activent que le bouton « Se connecter avec Google » et l'envoi Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel : restreindre l'accès à un domaine (ex. klocka.immo). Le mode
# « Internal » de Google le fait déjà ; ceci ajoute une seconde barrière.
# Attention : tant que ce champ est rempli, aucune autre adresse ne peut entrer.
ALLOWED_EMAIL_DOMAIN=

# Demander en plus l'autorisation d'envoyer des mails (portée gmail.send).
# false = la connexion sert uniquement à s'authentifier (consentement plus
# simple, rien à déclarer dans Data Access).
GOOGLE_GMAIL_SEND=false

# Lire la boîte de réception (portée gmail.readonly) : alimente l'onglet
# « Boîte de réception » de la page Mails et le bouton « Préanalyser » sur un
# mail reçu. Portée « restricted » chez Google : à déclarer dans Data Access.
# Les comptes déjà connectés doivent se reconnecter pour accorder la lecture.
GOOGLE_GMAIL_READ=false

# Classer les documents d'un deal dans le Drive du compte connecté (portée
# drive.file : l'app ne voit que les dossiers/fichiers qu'elle a créés).
GOOGLE_DRIVE=false
# Drive partagé de destination : les documents appartiennent alors à
# l'organisation, pas au compte qui les dépose. Par nom (le compte connecté doit
# en être membre) ou par identifiant, lu dans l'URL du Drive partagé.
GOOGLE_DRIVE_NOM=
GOOGLE_DRIVE_ID=
# Dossier d'accueil dans ce Drive partagé.
GOOGLE_DRIVE_DOSSIER=Projets
# Retrouver un Drive partagé créé par quelqu'un d'autre suppose la portée drive
# complète (drive.file ne voit que ce que l'app a créé). À n'activer que dans ce
# cas : elle donne accès à tout le Drive du compte connecté.
GOOGLE_DRIVE_COMPLET=false
# Agenda d'équipe : portée calendar.app.created (l'app ne voit que l'agenda
# qu'elle a créé, jamais les agendas personnels).
GOOGLE_CALENDAR=false
# Google Chat : AK, l'assistant de l'équipe dans le groupe (server/ak). Le
# compte AK_COMPTE, connecté depuis le dashboard avec cette portée, relit les
# espaces où il est membre toutes les AK_INTERVALLE_S secondes et répond
# quand on le mentionne (« @Assistant Klocka … »). Il faut activer l'API
# « Google Chat API » dans le projet Google Cloud du client OAuth.
GOOGLE_CHAT=false
AK_COMPTE=sourcing@klocka.immo
# Le nom du compte tel qu'il apparaît dans le chat : c'est lui qu'on mentionne.
AK_NOM=Assistant Klocka
# L'espace à suivre (spaces/XXXX), ou son nom affiché. Vide : tous les espaces
# où le compte est membre. Les messages privés au compte sont toujours suivis,
# et là AK répond à tout, sans qu'on le mentionne.
AK_ESPACE=KlockiTeam
AK_INTERVALLE_S=15
# Une fiche arrive dans une boîte de l'équipe : AK écrit en privé à ces
# adresses (séparées par des virgules) pour demander s'il la préanalyse. Un
# « oui » et il crée le dossier, puis revient avec son avis (négo, prix et
# loyer face au marché, emplacement, preneur, clients). Vide : personne.
AK_FICHES_POUR=
# Pour les essais : AK ne lit et n'écrit qu'en privé, jamais dans un groupe.
AK_PRIVE_SEUL=false
# Le modèle d'AK, quand on le veut moins cher que celui de la plateforme
# (ANTHROPIC_MODEL) : il traduit des phrases en actions, Sonnet suffit.
# AK_MODELE=claude-sonnet-5
# Le mot du matin dans le groupe (plan du jour, engagements en retard avec
# la personne mentionnée, dossiers sans agent), à cette heure, les jours
# ouvrés. Débranché dans le code : AK ne parle de lui-même que pour une
# fiche reçue et une tâche finie.
AK_BRIEF_HEURE=08:30
# AK se propose de lui-même dans le groupe (dossier incomplet : documents,
# agent, K-Data, projet, engagement en retard). Débranché dans le code, comme
# le mot du matin.
AK_PROACTIF_MIN=30
# L'oreille d'AK : le bouton « AK écoute le bureau » dans la pilule de
# l'assistant envoie ce que le navigateur entend ; AK relit toutes ces minutes
# et dit dans le groupe ce qu'il a retenu (registre, mémoire). Il ne crée
# rien tout seul.
AK_OREILLE_MIN=3
# Les projets Claude Code (« redesign la page K-Zoning ») : sur une copie du
# dépôt, branche ak/…, poussée ; jamais fusionnée sans un humain. Il faut un
# dépôt git avec son remote sur le serveur.
AK_DESIGN=false
# AK_DESIGN_MODELE=claude-sonnet-5
# Une fois sur AK_FLEMME, AK répond « Non j'ai la flemme de le faire
# débrouille-toi » et ne fait rien ; on redemande, il s'exécute. 0 : jamais.
AK_FLEMME=6
# Devant un message de plus de AK_RALE_CARACTERES (une fiche entière collée),
# AK râle et demande si c'est vraiment nécessaire ; un « oui » et il s'y met.
# 0 : jamais.
AK_RALE_CARACTERES=1500
# Relève automatique des boîtes connectées, en minutes.
MAIL_VEILLE_MINUTES=5
# Tri des mails relevés. Les domaines de l'équipe sont déduits des comptes
# connectés ; renseignez-les pour lever toute ambiguïté (séparés par des virgules).
MAIL_DOMAINES_INTERNES=
# Expéditeurs à ne jamais remonter, quoi qu'ils envoient (facturation, outils…).
MAIL_EXPEDITEURS_IGNORES=

# --- Cycle de vie des deals de préanalyse ---
# Nombre de jours avant de proposer une relance après une demande de documents.
DEAL_RELANCE_JOURS=7

# --- Carte Google Maps (front) ---
# Clé Google Maps Embed API pour les cartes des pages Préanalyse et Projet.
# Sans clé, un simple lien externe vers Google Maps est proposé.
VITE_GOOGLE_MAPS_API_KEY=

# --- Envoi par mot de passe d'application (optionnel, alternative à Google) ---
# Si vous préférez ne pas passer par OAuth. Un bloc par expéditeur, numéroté
# sans trou. Le mot de passe est un mot de passe d'application Google
# (https://myaccount.google.com/apppasswords), pas le mot de passe du compte.
# SMTP_1_NAME=Prénom Nom
# SMTP_1_USER=prenom@exemple.fr
# SMTP_1_PASS=xxxx xxxx xxxx xxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Monday (CRM : investisseurs, agents, transactions, biens écartés) ---
# Jeton personnel : dans Monday, avatar > Développeurs > Mes jetons d'accès.
MONDAY_TOKEN=
# Identifiants des tableaux, lus dans l'URL quand on les ouvre.
# Tableau « Propriétés » : les biens reçus y sont posés et suivis, jusqu'à
# l'archivage quand un dossier n'aboutit pas.
MONDAY_BOARD_PROPRIETES=
# Lus par Klocka, jamais écrits.
MONDAY_BOARD_INVESTISSEURS=
MONDAY_BOARD_AGENTS=

# Equimmox (analyse de loyer) : compte de service de l'équipe. Klocka pilote
# leur site dans un navigateur sans écran (playwright-core) : il faut donc un
# Chromium sur le serveur. En local, celui de Playwright suffit
# (npx playwright install chromium). Ailleurs, indiquer son chemin.
EQUIMMOX_EMAIL=
EQUIMMOX_MOT_DE_PASSE=
# CHROMIUM_PATH=/usr/bin/chromium
# Chez un hébergeur, « npm run chromium » télécharge le navigateur ; il part
# tout seul au déploiement (postinstall) sur Render, Fly, Railway et Heroku.
# Si l'hébergeur ne peut pas faire tourner Chromium, indiquez un navigateur
# distant (Browserless et consorts) et Klocka s'y connectera :
# EQUIMMOX_CDP_URL=wss://chrome.browserless.io?token=…

# --- Navigateur sans écran (Equimmox) ---
# Chez un hébergeur qui ne peut pas faire tourner Chromium : l'URL CDP d'un
# navigateur distant (Browserless et consorts). EQUIMMOX_CDP_URL reste lu par
# compatibilité.
NAVIGATEUR_CDP_URL=

# --- Recoupement des sources de marché ---
# Equimmox constate des baux signés, la valeur locative du secteur et le loyer
# déduit des ventes estiment : les lectures sont interrogées
# et comparées. Au-delà de cet écart relatif entre leurs deux lectures, un
# drapeau rouge se lève dans le bilan. 0.15 = 15 %.
MARCHE_ECART_ALERTE=0.15

# --- Sources publiques de marché (aucune clé, aucun compte) --------------------
# DVF : les ventes réellement conclues, publiées par Etalab à partir des actes
# transmis à la DGFiP. Rien à configurer ; cette variable ne sert qu'à pointer
# vers un miroir ou un jeu figé en test.
# DVF_RACINE=https://files.data.gouv.fr/geo-dvf/latest/csv
#
# Le BODACC s'interroge sur l'API Opendatasoft de la DILA, sans clé.

# --- K-Vacance : le registre des établissements, complet -------------------
# L'API Sirene de l'INSEE lit tous les commerces d'une commune, actifs et
# fermés, avec leurs dates et leur point : c'est elle qui permet de dire si la
# vacance d'un quartier est forte ou faible face à sa commune.
#
# Gratuit, en quatre temps sur https://portail-api.insee.fr :
#   1. se connecter en « Connexion pour les externes », puis créer un compte ;
#   2. créer une application en mode « simple » — surtout pas « backend to
#      backend », que le mode d'emploi de l'INSEE dit inopérant pour cette API.
#      Laisser vides le client ID et le champ souscription ;
#   3. Catalogue > API Sirene > Souscrire, plan « Public », le seul existant ;
#   4. la clé apparaît dans l'onglet « souscriptions » de l'application. Elle
#      n'a pas de date de fin, et se renouvelle ou se révoque de là.
# Trente requêtes par minute, deux mille par heure ; une commune lue se garde
# trente jours. Le registre étant mis à jour de nuit, l'INSEE recommande de ne
# pas l'interroger avant 10 h.
# Sans clé, K-Vacance ne lit que la vacance visible d'OpenStreetMap et le dit.
INSEE_SIRENE_CLE=

# --- ALX, la prospection off-market --------------------------------------------
# La société derrière une adresse (dirigeants, création, code APE) se lit dans
# l'annuaire des entreprises de l'État, gratuit et sans clé : rien à poser.
# Google, côté serveur : la balade dans une rue (Places API, les commerces tels
# que Maps les montre) et la photo d'une devanture (Street View Static API).
# Une clé DISTINCTE de VITE_GOOGLE_MAPS_API_KEY : celle-ci reste sur le
# serveur, restreinte à ces deux API, jamais envoyée au navigateur.
# Console Google Cloud > Library : activer « Places API » et « Street View
# Static API » > Credentials > API key.
GOOGLE_MAPS_SERVEUR=
