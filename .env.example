# Copy to .env and fill in as needed.

# --- Backend (server/index.js) ---
# Anthropic API key to enable real AI features (InvokeLLM, KlockAI agent,
# document extraction). If unset, AI calls return safe placeholder responses.
ANTHROPIC_API_KEY=

# Model used for all AI features (any valid Claude model id).
# Examples: claude-sonnet-4-5 (default), claude-opus-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# Backend port (frontend dev proxy points here).
PORT=3001

# Admin account email seeded on first run / used as the current user.
KLOCKA_ADMIN_EMAIL=jules.btmf@gmail.com

# --- Frontend (Vite) ---
# Where the Vite dev server proxies /api and /uploads. Defaults to the PORT above.
VITE_BACKEND_URL=http://localhost:3001
